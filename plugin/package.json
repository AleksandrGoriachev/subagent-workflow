{
  "name": "dsh-workflow-console",
  "version": "0.8.0",
  "private": true,
  "description": "Read-only workflow console for subagent-workflow repositories in DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "vendor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AleksandrGoriachev/subagent-workflow"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-0 <0.3.0"
  },
  "scripts": {
    "test": "node tools/test.mjs",
    "check:client": "node --check lib/client.js",
    "dev": "node tools/dev-server.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
