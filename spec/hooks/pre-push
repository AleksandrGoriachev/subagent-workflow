#!/bin/sh
# subagent-workflow 2.6.24 — push не проносит изменение мимо задания.
#
# git передаёт обновляемые ссылки на stdin: <local ref> <local sha> <remote ref>
# <remote sha>. Для каждой существующей ссылки проверяется диапазон, который
# уезжает: remote..local. Для новой ссылки — коммиты, которых ещё нет ни в одном
# remote (git rev-list --not --remotes); если вся история новая, диапазон
# начинается с пустого дерева.
#
# Пределы те же, что у commit-msg: git push --no-verify пропускает хук целиком.
repo=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
guard="$repo/docs/subagent-workflow/scripts/task-guard.mjs"
[ -f "$guard" ] || exit 0
# 2.6.24 (0060, WC-42): порядок резолва node: $WF_NODE → docs/subagent-workflow/.node-path
# (его пишет init) → command -v node. В bundled-окружении PATH node не содержит, и
# блокирующий commit-msg молча пропускал проверку покрытия. Путь, которого нет,
# считается ненайденным. Найден — guard работает как раньше; не найден —
# предупреждение один раз на репозиторий (маркер в git-path), дальше хуки молчат.
node_bin=""
if [ -n "${WF_NODE:-}" ]; then
  wf_node=$(printf '%s' "$WF_NODE" | tr '\\' '/')
  if [ -f "$wf_node" ]; then node_bin="$wf_node"; fi
fi
if [ -z "$node_bin" ] && [ -f "$repo/docs/subagent-workflow/.node-path" ]; then
  node_line=$(head -n 1 "$repo/docs/subagent-workflow/.node-path" 2>/dev/null | tr -d '\r')
  node_line=$(printf '%s' "$node_line" | tr '\\' '/')
  if [ -n "$node_line" ] && [ -f "$node_line" ]; then node_bin="$node_line"; fi
fi
if [ -z "$node_bin" ]; then
  node_bin=$(command -v node 2>/dev/null || true)
fi
if [ -z "$node_bin" ]; then
  marker=$(git rev-parse --git-path workflow-node-missing 2>/dev/null)
  case "$marker" in
    /*) ;;
    *) if [ -n "$marker" ]; then marker="$repo/$marker"; fi ;;
  esac
  if [ -n "$marker" ] && [ -f "$marker" ]; then exit 0; fi
  echo "task-guard: node не найден — проверка перед push пропущена" >&2
  if [ -n "$marker" ]; then : > "$marker"; fi
  exit 0
fi
zero="0000000000000000000000000000000000000000"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    first=$(git rev-list --reverse "$local_sha" --not --remotes 2>/dev/null | head -n 1)
    base=""
    if [ -n "$first" ]; then
      base=$(git rev-parse --verify -q "$first^" 2>/dev/null)
    fi
    if [ -z "$base" ]; then
      base=$(git hash-object -t tree /dev/null 2>/dev/null)
    fi
    range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  "$node_bin" "$guard" --repo "$repo" --range "$range" || status=1
done
exit $status
