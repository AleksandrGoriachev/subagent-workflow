{
  "task": "NNNN",
  "setup": [],
  "teardown": [],
  "redExpect": {
    "mustFail": ["C1", "C3"],
    "mustPass": ["C2"],
    "reasonWindow": 25,
    "reasons": {
      "C1": "<подстрока stdout+stderr в вердиктной зоне (последние reasonWindow непустых строк): почему C1 обязан падать на базе>",
      "C3": "<подстрока stdout+stderr в вердиктной зоне (последние reasonWindow непустых строк): почему C3 обязан падать на базе>"
    },
    "noRed": {
      "reason": "<только risk=low: почему красного нет; тогда mustFail: [] — без этой строки lint откажет>"
    }
  },
  "criteria": [
    {
      "id": "C1",
      "title": "Поведение: <что должно произойти>",
      "command": "node --test tests/example.test.mjs",
      "cwd": ".",
      "covers": ["src/**"],
      "timeoutMs": 120000,
      "expect": {
        "exitCode": 0,
        "stdoutRegex": "pass [1-9]"
      },
      "tags": ["fast"]
    },
    {
      "id": "C2",
      "title": "Негативный случай: <что должно быть отвергнуто>",
      "command": "node checks/negative-case.mjs",
      "timeoutMs": 60000,
      "expect": {
        "exitCode": 1,
        "stderrContains": "invalid"
      },
      "tags": ["fast", "negative"]
    },
    {
      "id": "C3",
      "title": "Эффект: <что видит пользователь>",
      "command": "node checks/effect.mjs",
      "covers": ["src/**"],
      "effect": {
        "observable": "<наблюдаемое состояние: квитанция, сумма, отсутствие ошибки>",
        "threshold": "<порог: ≤ 5 s, 0 потерь, 100%>",
        "measuredBy": "C1"
      },
      "timeoutMs": 120000,
      "expect": { "exitCode": 0 },
      "tags": ["fast"]
    }
  ]
}
