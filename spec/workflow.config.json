{
  "version": 1,
  "tasksDir": "docs/tasks",
  "keysFile": "docs/subagent-workflow/acceptors.json",
  "logs": "local",
  "actor": {
    "primaryEnv": "DSH_SESSION_ID",
    "fallbackEnv": "TASK_ACTOR_SESSION",
    "modelEnv": "DSH_MODEL",
    "sources": [
      { "env": "DSH_SESSION_ID", "kind": "harness" },
      { "env": "WF_ACTOR_SESSION", "kind": "runner" }
    ],
    "modelSources": ["DSH_MODEL", "WF_ACTOR_MODEL"]
  },
  "policy": {
    "decisions": "fail",
    "coverage": "fail",
    "attack": "off",
    "roles": {
      "modelFamily": "warn"
    }
  },
  "models": {},
  "roles": {},
  "verifyTimeoutMs": 1800000,
  "guard": {
    "enabled": false,
    "mode": "fail",
    "allow": [],
    "bypassMarker": "workflow-bypass"
  }
}
