  },
  "transport": {
    "sslBackend": "openssl",
    "terminalPrompt": "0"
  },
  "packageCache": ".tmp/npm-cache",
  "evidence": [
    "tag",
    "releaseUrl",
    "assetSize",
    "httpStatus",
    "smokeAsset",
    "receipt"
  ],
  "failurePolicy": "stop-and-rollback-draft",
  "acceptance": {
    "task": "docs/tasks/0147",
    "rule": "приёмка следует за candidate-коммитом выпуска: вердикт подписывает отдельная сессия приёмщика"
  }
