    "plugin/package.json",
    "CHANGELOG.md"
  ],
  "panelMetadataField": {
    "file": "package.json",
    "key": "dshPanelVersion",
    "value": "0.9.39"
  },
  "credentialSource": {
    "path": "~/.git-credentials",
