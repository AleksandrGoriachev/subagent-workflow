  "packageRoot": "subagent-workflow-v2",
  "task": "docs/tasks/0147",
  "releaseCommand": "node tools/release.mjs release 2.6.111",
  "preflightCommand": "node tools/release.mjs preflight 2.6.111",
  "versionCheckCommand": "node tools/check-version.mjs",
  "versionFiles": [
    "VERSION",
    "package.json",
    "README.md",
