      "id": "C1",
      "title": "Цель версии 2.6.95 и панель 0.9.38",
      "command": "node -e \"const fs=require('fs');const p=require('./package.json');const pl=require('./plugin/package.json');process.stdout.write(fs.readFileSync('VERSION','utf8').trim()+'|'+p.version+'|'+String(p.dshPanelVersion)+'|'+pl.version)\"",
      "cwd": ".",
      "covers": [
        "VERSION",
        "package.json",
        "plugin/package.json"
      ],
      "timeoutMs": 120000,
      "tags": [
        "fast"
      ],
      "expect": {
        "exitCode": 0,
        "stdoutContains": "2.6.95|2.6.95|0.9.38|0.9.38"
      }
    },
    {
      "id": "C2",
      "title": "check-version 2.6.95",
      "command": "node tools/check-version.mjs",
      "cwd": ".",
      "covers": [
        "README.md",
        "spec/SPEC.md",
        "spec/scripts/lib/common.mjs",
        "CHANGELOG.md"
      ],
      "timeoutMs": 300000,
      "tags": [
        "fast"
      ],
      "expect": {
        "exitCode": 0,
        "stdoutContains": "VERSION OK: 2.6.95"
      }
    },
    {
      "id": "C3",
      "title": "предполёт 2.6.95",
      "command": "node tools/release.mjs preflight 2.6.95",
