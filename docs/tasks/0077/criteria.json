{
  "task": "0077",
  "setup": [],
  "teardown": [],
  "redExpect": {
    "mustFail": [
      "C1",
      "C2",
      "C4"
    ],
    "mustPass": [
      "C3",
      "C5",
      "C6",
      "C7"
    ],
    "reasonWindow": 25,
    "reasons": {
      "C1": "2.6.83",
      "C2": "VERSION OK: 2.6.83",
      "C4": "нет тега v2.6.84"
    }
  },
  "criteria": [
    {
      "id": "C1",
      "title": "Цель версии 2.6.84 и панель 0.9.38 согласованы в файлах и брифе",
      "command": "node -e \"const fs=require('fs');const p=require('./package.json');const pl=require('./plugin/package.json');const b=require('./release.config.json');process.stdout.write(fs.readFileSync('VERSION','utf8').trim()+'|'+p.version+'|'+String(p.dshPanelVersion)+'|'+pl.version+'|'+b.version)\"",
      "cwd": ".",
      "covers": [
        "VERSION",
        "package.json",
        "plugin/package.json",
        "release.config.json",
        "plugin/lib/compat.js"
      ],
      "timeoutMs": 60000,
      "tags": [
        "fast"
      ],
      "expect": {
        "exitCode": 0,
        "stdoutContains": "2.6.84|2.6.84|0.9.38|0.9.38|2.6.84"
      }
    },
    {
      "id": "C2",
      "title": "check-version подтверждает 2.6.84 во всех файлах версии",
      "command": "node tools/check-version.mjs",
      "cwd": ".",
      "covers": [
        "README.md",
        "spec/SPEC.md",
        "spec/scripts/lib/common.mjs",
        "CHANGELOG.md"
      ],
      "timeoutMs": 120000,
      "tags": [
        "fast"
      ],
      "expect": {
        "exitCode": 0,
        "stdoutContains": "VERSION OK: 2.6.84"
      }
    },
    {
      "id": "C3",
      "title": "Полный набор плагина зелёный на выпуске",
      "command": "node plugin/tools/test.mjs",
      "cwd": ".",
      "covers": [
        "plugin/package.json"
      ],
      "timeoutMs": 900000,
      "tags": [
        "slow"
      ],
      "expect": {
        "exitCode": 0,
        "stdoutContains": "pass 308"
      }
    },
    {
      "id": "C4",
      "title": "Релиз v2.6.84 опубликован с ассетами и квитанцией SMOKE",
      "command": "node docs/tasks/0077/release-artifacts.mjs",
      "cwd": ".",
      "covers": [
        "docs/tasks/0077/release-artifacts.mjs"
      ],
      "timeoutMs": 180000,
      "tags": [
        "network"
      ],
      "expect": {
        "exitCode": 0,
        "stdoutContains": "ARTIFACTS OK v2.6.84"
      }
    },
    {
      "id": "C5",
      "title": "Квитанции приёмки у опубликованных релизов на месте",
      "command": "node spec/checks/release-receipt.mjs --online",
      "cwd": ".",
      "covers": [
        "plugin/package.json"
      ],
      "timeoutMs": 180000,
      "tags": [
        "network"
      ],
      "expect": {
        "exitCode": 0,
        "stdoutContains": "release-receipt: OK"
      }
    },
    {
      "id": "C6",
      "title": "Регресс правил пакета не сломан выпуском",
      "command": "node spec/selftest.mjs",
      "cwd": ".",
      "covers": [
        "spec/SPEC.md"
      ],
      "timeoutMs": 900000,
      "tags": [
        "slow"
      ],
      "expect": {
        "exitCode": 0,
        "stdoutContains": "SELFTEST OK"
      }
    },
    {
      "id": "C7",
      "title": "Негативный случай: проверка ассетов отвергает несуществующий тег",
      "command": "set WF_EXPECT_TAG=v0.0.1&&node docs/tasks/0077/release-artifacts.mjs",
      "cwd": ".",
      "covers": [
        "docs/tasks/0077/release-artifacts.mjs"
      ],
      "timeoutMs": 180000,
      "tags": [
        "negative",
        "network"
      ],
      "expect": {
        "exitCode": 1,
        "stderrContains": "нет тега v0.0.1"
      }
    }
  ]
}
